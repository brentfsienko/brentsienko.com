# Vercel Blob — auto-set when you create/link a Blob store, or paste from
# Vercel → Storage → Blob → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Shared password for /blog/write
BLOG_ADMIN_PASSWORD=choose-a-strong-password

# Random secret used to sign the admin session cookie
# e.g. openssl rand -base64 32
BLOG_SESSION_SECRET=replace-with-long-random-string
