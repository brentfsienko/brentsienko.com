# Vercel Blob — auto-set when you create/link a Blob store, or paste from
# Vercel → Storage → Blob → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Shared password for /blog/write (also gates /radio/connect)
BLOG_ADMIN_PASSWORD=choose-a-strong-password

# Random secret used to sign the admin session cookie
# e.g. openssl rand -base64 32
BLOG_SESSION_SECRET=replace-with-long-random-string

# Spotify — radio tab
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add redirect URI: https://brentsienko.com/api/radio/callback
#    (also add http://localhost:3000/api/radio/callback for local dev)
# 3. Visit /radio/connect (logged in with blog password), authorize, paste token here
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REFRESH_TOKEN=your_refresh_token
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/radio/callback
# Optional: hard-code your Daylist playlist ID as a fallback
# SPOTIFY_DAYLIST_PLAYLIST_ID=37i9dQZF1EP6YuccBxUcC1
